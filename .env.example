# ─────────────────────────────────────────────
#  Telegram
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# If you run a local Bot API server, set this URL (optional)
# TELEGRAM_LOCAL_SERVER_URL=http://localhost:8081

# ─────────────────────────────────────────────
#  GitHub
# ─────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name
GITHUB_BRANCH=main

# ─────────────────────────────────────────────
#  Upload settings
# ─────────────────────────────────────────────
# Base directory inside the repo for uploads
UPLOAD_BASE_PATH=uploads

# What to do when a file already exists: "overwrite" or "version"
FILE_CONFLICT_STRATEGY=version

# ─────────────────────────────────────────────
#  Access control (comma-separated Telegram user IDs)
# ─────────────────────────────────────────────
ALLOWED_USER_IDS=123456789,987654321

# Telegram user ID for the admin (receives error reports)
ADMIN_USER_ID=123456789

# ─────────────────────────────────────────────
#  Logging
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
