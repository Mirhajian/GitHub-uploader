# ── Telegram ──────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get these from https://my.telegram.org → "API development tools"
# Required to run the local Bot API server
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# URL where your local Telegram Bot API server is running
# The server must be started before the bot (see README for setup)
TELEGRAM_LOCAL_SERVER_URL=http://localhost:8081

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token with repo → contents read/write scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repository details
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repo_name
GITHUB_BRANCH=main

# ── Upload behaviour ──────────────────────────────────────────────────────────
# Base folder inside the repo where files land (no leading/trailing slashes)
UPLOAD_BASE_PATH=uploads

# What to do when a file with the same name already exists:
#   overwrite  → replace the file (updates the existing blob)
#   version    → keep both, renaming the new one as file_1.ext, file_2.ext …
FILE_CONFLICT_STRATEGY=version

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone (open mode).
ALLOWED_USER_IDS=123456789,987654321

# Optional: a single admin user ID that receives error notifications.
ADMIN_USER_ID=123456789

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
